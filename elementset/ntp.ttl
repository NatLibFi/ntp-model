ntp-meta: a owl:Ontology ;
    dcterms:description "Additional properties supporting NTP data model."@en,
        "Sisältää lisäominaisuuksia NTP-tietomallia varten."@fi ;
    dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "Metadata ontology for NTP data model"@en,
        "Metadataontologia NTP-tietomallin tueksi"@fi .

ntp-meta:typeOfViewingRestriction a owl:DatatypeProperty ;
    skos:prefLabel "näyttörajoitteen kohde ja tyyppi"@fi ;
    dcterms:modified "2026-01-26 (New)" ;
    rdfs:domain rdf:Property ;
    rdfs:range rdfs:Literal ;
    skos:note """U = Ulkoiset rajoitukset = mitä näyttörajoituksia on Nimitietopalvelun sisältöä avattaessa esim. Finnassa

SI = Sisäiset rajoitukset = mitä näyttörajoituksia on Nimitietopalvelun tuottajille

Sisäinen rajoitus tarkoittaa myös ulkoista rajoitusta
Sisäiset rajoitukset kohdistuvat NTP-tuottajiin, jotka ovat saaneet yleisen oikeuden käsitellä kuvailutietoja.
Niissä kuvailutiedoissa, jotka tuotetaan primääristi NTP:ssä, on voitava tarkemmin määritellä, kenelle tiedot ovat näytettävissä
T = Täysrajoitus = ei saa tallentaa tietoa Nimitietopalveluun

Ne kuvailutiedot (esim. arkistoissa), joita ei halua näyttää kaikille NTP-tuottajille, ei tuoda NTP:hen
Silloin kun NTP:tä käytetään primäärinä tuotantoympäristönä, täytyy nämä tiedot rajata vain jonkin ryhmän käytettäviksi.
Y = Rajoitus koskee yhteisöä

H = Rajoitus koskee henkilöä

SU = Rajoitus koskee sukua""" .

ntp-meta:viewingRestriction a owl:DatatypeProperty ;
    skos:prefLabel "näyttörajoitus"@fi ;
    dcterms:modified "2026-01-26 (New)" ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

ntp: a ntp:Class,
        owl:Ontology ;
    dcterms:contributor "Katerina Sornova",
        "Matias Frosterus",
        "Okko Vainonen" ;
    dcterms:creator "Jarmo Saarikko" ;
    dcterms:license "http://creativecommons.org/publicdomain/zero/1.0/" ;
    dcterms:modified "2021-04-29T19:00:00+02:00"^^xsd:dateTime ;
    dcterms:publisher "http://urn.fi/URN:NBN:fi:au:finaf:000034269" ;
    skos:changeNote "v2.25: added language to editorial notes " ;
    skos:prefLabel "Nimitietopalvelun tietomalli v.2.26"@fi .

ntp:Concept a owl:Class ;
    skos:altLabel "Aihe"@fi ;
    skos:closeMatch skos:Concept ;
    skos:prefLabel "Concept"@en,
        "Käsite"@fi .

ntp:Event a owl:Class ;
    rdfs:subClassOf ntp:CorporateBody ;
    skos:prefLabel "Event"@en,
        "Tapahtuma"@fi .

ntp:IdentifierForPerson a ntp:String,
        rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain ntp:Person ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://rdaregistry.info/Elements/a/datatype/P50094>,
        <http://uri.suomi.fi/datamodel/ns/jhs#tunniste> ;
    skos:note "Ydinelementti" ;
    skos:prefLabel "henkilön tunniste"@fi .

ntp:acronym a ntp:String,
        rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( ntp:Person ntp:CorporateBody ) ] ;
    rdfs:range xsd:string ;
    skos:altLabel "lyhenne;akronyymi"@fi ;
    skos:prefLabel "acronym"@en,
        "lyhenne"@fi .

ntp:addressOfAgent a ntp:String,
        rdf:Property,
        owl:DatatypeProperty ;
    ntp-meta:typeOfViewingRestriction "U: Y, H ja SU / SI: H / T: H" ;
    ntp-meta:viewingRestriction true ;
    rdfs:domain ntp:Agent ;
    rdfs:range xsd:string ;
    skos:altLabel "toimijan osoite"@fi ;
    skos:closeMatch <http://rdaregistry.info/Elements/a/P50036>,
        <http://rdaregistry.info/Elements/a/P50114>,
        <http://rdaregistry.info/Elements/a/P50418>,
        <http://rdaregistry.info/Elements/u/P60512>,
        <http://www.w3.org/ns/locn#Address>,
        org:siteAddress ;
    skos:prefLabel "address of agent"@en,
        "toimijan osoite"@fi .

ntp:addressOfCorporateBody a ntp:String,
        rdf:Property,
        owl:DatatypeProperty ;
    ntp-meta:typeOfViewingRestriction "U: Y" ;
    ntp-meta:viewingRestriction true ;
    rdfs:domain ntp:CorporateBody ;
    rdfs:range xsd:string ;
    skos:closeMatch <http://rdaregistry.info/Elements/a/P50036> ;
    skos:prefLabel "address of corporate body"@en,
        "yhteisön osoite"@fi .

