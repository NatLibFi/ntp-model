    rdfs:subClassOf ntp:Agent ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10008>,
        ntp:Agent ;
    skos:prefLabel "Family"@en,
        "Suku"@fi .

ntp:Place a owl:Class ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10009> ;
    skos:prefLabel "Paikka"@fi .

ntp:Work a owl:Class ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10001> ;
    skos:prefLabel "Teos"@fi .

ntp:Nomen a owl:Class ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10012> ;
    skos:prefLabel "Nomen"@en,
        "Nomen"@fi .

ntp:Entity a owl:Class ;
    skos:altLabel "Auktoriteettiresurssi"@fi ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10013> ;
    skos:prefLabel "Entity"@en,
        "Entiteetti"@fi .

ntp:Monolingualtext a rdfs:langString,
        owl:Class ;
    rdfs:comment "wikibase datatyyppi" ;
    rdfs:subClassOf rdfs:Literal ;
    skos:prefLabel "Monolingual text"@en,
        "Yksikielinen teksti"@fi .

ntp:Agent a owl:Class ;
    rdfs:subClassOf ntp:Entity ;
    skos:altLabel "toimija"@fi ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10002> ;
    skos:prefLabel "Agent"@en,
        "Toimija"@fi .

ntp:CorporateBody a owl:Class ;
    rdfs:subClassOf ntp:Agent ;
    skos:altLabel "Organisaatio"@fi,
        "Yhteisö"@fi ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10005>,
        <http://uri.suomi.fi/terminology/prh/c37>,
        org:Organization ;
    skos:prefLabel "Yhteisö"@fi .

ntp:Person a owl:Class ;
    rdfs:subClassOf ntp:Agent ;
    skos:closeMatch <http://rdaregistry.info/Elements/c/C10004>,
        <http://uri.suomi.fi/terminology/idha/concept-5>,
        <http://www.w3.org/ns/person#Person> ;
    skos:prefLabel "Person"@en,
        "Henkilö"@fi .

ntp:Item a owl:Class ;
    rdfs:comment "wikibase datatyyppi" ;
    rdfs:subClassOf rdfs:Literal ;
    rdfs:type xsd:anyURI ;
    skos:prefLabel "Item"@en,
        "Item"@fi .

ntp:String a xsd:string,
        owl:Class ;
    rdfs:comment "wikibase datatyyppi" ;
    rdfs:subClassOf rdfs:Literal ;
    skos:prefLabel "String"@en,
        "Merkkijono"@fi .

