        rdf:Property,
        owl:DatatypeProperty ;
    ntp-meta:typeOfViewingRestriction "U: H / SI: H / T: H" ;
    ntp-meta:viewingRestriction true ;
    rdfs:domain ntp:Person ;
    rdfs:range xsd:string ;
    skos:altLabel "henkilön osoite"@fi ;
    skos:closeMatch <http://rdaregistry.info/Elements/a/datatype/P50114> ;
